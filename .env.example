# تنظیم‌های استقرار داکری. این فایل را روی سرور به .env کپی کنید و مقدارها را عوض کنید.

# نشانی عمومی سایت (بدون اسلش آخر). روی سرور واقعی مثلاً https://sinner.ir
PUBLIC_URL=http://localhost:8080

# درگاهی که انجین‌ایکس روی سرور می‌گیرد. روی سرور واقعی معمولاً 80
HTTP_PORT=8080

APP_NAME=SInner
# با دستور: docker compose run --rm backend php artisan key:generate --show
APP_KEY=

DB_DATABASE=sinner
DB_USERNAME=sinner
DB_PASSWORD=

# فقط بار اول، برای پر کردن پایگاه داده‌ی خالی با داده‌ی نمونه
DB_SEED=false

# درگاه‌های دیباگ روی خود سرور (به اینترنت باز نیستند)
DB_HOST_PORT=5434
REDIS_HOST_PORT=6382

# گواهی امنیتی: برای رفتن روی https مقدار زیر را به https.conf عوض کنید
# و دو فایل fullchain.pem و privkey.pem را در پوشه‌ی گواهی بگذارید.
NGINX_CONF=default.conf
HTTPS_PORT=8443
TLS_CERT_DIR=./docker/nginx/certs
